{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhine Fleet Control",
  "version": "0.1.0",
  "identifier": "cc.rhine.mock.admin",
  "build": { "frontendDist": "../../ui" },
  "app": {
    "windows": [{
      "label": "main",
      "title": "RHINE LAB · 管理面",
      "width": 1480, "height": 920, "minWidth": 1080, "minHeight": 700,
      "center": true,
      "url": "admin/index.html"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src http://* https://* ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
